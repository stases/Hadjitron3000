{
  "format": "hadjitron3000/sound",
  "version": 3,
  "sound": {
    "name": "Gated Pad",
    "source": {
      "id": "source",
      "type": "osc",
      "params": {
        "wave": "sawtooth",
        "voices": 5,
        "spread": 20,
        "width": 0.8
      }
    },
    "filter": {
      "on": true,
      "mode": "lowpass",
      "cutoff": 2200,
      "reso": 0.1
    },
    "amp": {
      "attack": 0.05,
      "decay": 0.5,
      "sustain": 0.9,
      "release": 0.4
    },
    "chain": [
      {
        "id": "fx1",
        "type": "reverb",
        "params": {
          "size": 2,
          "tone": 5000,
          "mix": 0.15
        }
      }
    ],
    "mods": [
      {
        "id": "mod1",
        "type": "lfo",
        "params": {
          "wave": "square",
          "sync": "1/16",
          "retrigger": true
        },
        "per": "sound",
        "target": {
          "module": "out",
          "param": "level"
        },
        "amount": 0.35
      },
      {
        "id": "mod2",
        "type": "lfo",
        "params": {
          "wave": "triangle",
          "sync": "1/16",
          "retrigger": true
        },
        "per": "sound",
        "target": {
          "module": "out",
          "param": "level"
        },
        "amount": 0.65
      }
    ],
    "out": {
      "level": -14.5,
      "pan": 0
    }
  },
  "samples": {}
}
