{
  "format": "hadjitron3000/sound",
  "version": 3,
  "sound": {
    "name": "Phase Pad",
    "source": {
      "id": "source",
      "type": "osc",
      "params": {
        "wave": "sawtooth",
        "voices": 3,
        "spread": 20,
        "width": 0.7
      }
    },
    "filter": {
      "on": true,
      "mode": "lowpass",
      "cutoff": 2200,
      "reso": 0.1
    },
    "amp": {
      "attack": 0.6,
      "decay": 1.0,
      "sustain": 0.85,
      "release": 1.6
    },
    "chain": [
      {
        "id": "fx1",
        "type": "phaser",
        "params": {
          "sync": "2bar",
          "depth": 0.8,
          "feedback": 0.5,
          "stages": "8",
          "mix": 0.5
        }
      },
      {
        "id": "fx2",
        "type": "reverb",
        "params": {
          "size": 4,
          "tone": 5000,
          "mix": 0.35
        }
      }
    ],
    "mods": [],
    "out": {
      "level": -7,
      "pan": 0
    }
  },
  "samples": {}
}
