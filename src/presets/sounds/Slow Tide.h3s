{
  "format": "hadjitron3000/sound",
  "version": 3,
  "sound": {
    "name": "Slow Tide",
    "source": {
      "id": "source",
      "type": "osc",
      "params": {
        "wave": "sawtooth",
        "voices": 5,
        "spread": 18,
        "width": 0.9,
        "wave2": "triangle",
        "pitch2": 12,
        "mix2": 0.3
      }
    },
    "filter": {
      "on": true,
      "mode": "lowpass",
      "cutoff": 900,
      "reso": 0.15
    },
    "amp": {
      "attack": 12,
      "decay": 3,
      "sustain": 0.85,
      "release": 14
    },
    "chain": [
      {
        "id": "fx1",
        "type": "reverb",
        "params": {
          "size": 9,
          "tone": 4500,
          "mix": 0.4
        }
      }
    ],
    "mods": [
      {
        "id": "mod1",
        "type": "drift",
        "params": {
          "rate": 0.4,
          "smooth": 1
        },
        "per": "note",
        "target": {
          "module": "source",
          "param": "pitch"
        },
        "amount": 0.003
      },
      {
        "id": "mod2",
        "type": "drift",
        "params": {
          "rate": 0.05,
          "smooth": 1
        },
        "per": "sound",
        "target": {
          "module": "filter",
          "param": "cutoff"
        },
        "amount": 0.2
      }
    ],
    "out": {
      "level": -8,
      "pan": 0
    }
  },
  "samples": {}
}
