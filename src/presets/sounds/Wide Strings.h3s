        "type": "chorus",
        "params": {
          "rate": 0.5,
          "depth": 0.5,
          "spread": 1,
          "mix": 0.5
        }
      },
      {
        "id": "fx2",
        "type": "width",
        "params": {
          "width": 1.6,
          "bass": 150
        }
      },
      {
        "id": "fx3",
        "type": "reverb",
        "params": {
          "size": 3.5,
          "tone": 6000,
          "mix": 0.3
        }
      }
    ],
    "mods": [],
